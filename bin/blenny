# ── Command dispatch ───────────────────────────────────────────
def _run_qa_agent(args: list[str]) -> int:
    """Run qa-agent script with given args, returns exit code."""
    python = _ensure_python()
    cmd = [python, str(QA_AGENT)] + args
    result = subprocess.run(cmd)
    return result.returncode


def _cmd_version():
    """Print version info — blenny + backend."""
    try:
        python = _ensure_python()
        backend = subprocess.run(
            [python, str(QA_AGENT), "--version"],
            capture_output=True, text=True, timeout=5
        )
        backend_ver = backend.stdout.strip()
    except Exception:
        backend_ver = None

    print(f"blenny version {BLENNY_VERSION}")
    if backend_ver:
        print(f"backend: {backend_ver}")
    return 0


def _cmd_help(cmd: str | None = None):
    """Print help text."""
    if cmd and cmd in HELP_TEXT:
        print(HELP_TEXT[cmd])
    else:
        print(HELP_TEXT["blenny"])
    return 0


def _help_requested(args: list[str]) -> bool:
    """Check if -h/--help is anywhere in remaining args."""
    return any(a in ("-h", "--help") for a in args)


def _requires_name(cmd: str, rest: list[str]) -> bool:
    """Validate that a positional name was provided; return error if not."""
    if not rest or rest[0].startswith("-"):
        print(f"blenny: '{cmd}' requires a repo name", file=sys.stderr)
        print(f"Usage: blenny {cmd} <repo-name>", file=sys.stderr)
        return False
    return True


# ── Subcommand handlers ────────────────────────────────────────
def _cmd_init():
    return _run_qa_agent(["init"])

def _cmd_onboard(rest: list[str]):
    return _run_qa_agent(["onboard"] + rest)

def _cmd_install():
    print(HELP_TEXT["install"])
    return 0

def _cmd_update():
    return _run_qa_agent(["update"])

def _cmd_status(rest: list[str]):
    args = ["status"]
    if rest and not rest[0].startswith("-"):
        args.extend(["--repo", rest[0]])
        rest = rest[1:]
    return _run_qa_agent(args + rest)

def _cmd_scan(name: str, passthrough: list[str]):
    return _run_qa_agent(["run", "--repo", name, "--phase", "issue-cycle", "--no-dry-run"] + passthrough)

def _cmd_ink(name: str, passthrough: list[str]):
    return _run_qa_agent(["run", "--repo", name, "--phase", "pr-cycle", "--no-dry-run"] + passthrough)

def _cmd_duster(name: str):
    return _run_qa_agent(["run", "--repo", name, "--phase", "issue-cycle", "--dry-run"])

def _cmd_doctor(rest: list[str]):
    args = ["doctor"]
    if rest and not rest[0].startswith("-"):
        args.extend(["--repo", rest[0]])
        rest = rest[1:]
    return _run_qa_agent(args + rest)

def _cmd_run(name: str, passthrough: list[str]):
    return _run_qa_agent(["run", "--repo", name, "--phase", "orchestrated", "--no-dry-run"] + passthrough)

def _cmd_secrets(path: str):
    python = _ensure_python()
    return subprocess.run([python, str(BLENNY_SECRETS), path]).returncode

def _cmd_health(name: str, passthrough: list[str]):
    return _run_qa_agent(["health", "--repo", name] + passthrough)

def _cmd_report(name: str, passthrough: list[str]):
    return _run_qa_agent(["report", "--repo", name, "--format", "pdf"] + passthrough)

def _cmd_preflight(rest: list[str]):
    return _run_qa_agent(["preflight"] + rest)

def _cmd_heal(rest: list[str]):
    return _run_qa_agent(["heal"] + rest)

def _cmd_ci(name: str, passthrough: list[str]):
    return _run_qa_agent(["ci", "--repo", name] + passthrough)

def _cmd_install_hook(name: str, passthrough: list[str]):
    return _run_qa_agent(["install-hook", "--repo", name] + passthrough)


def _cmd_install_cron(name: str, passthrough: list[str]):
    return _run_qa_agent(["install-cron", "--repo", name] + passthrough)


# ── Main ───────────────────────────────────────────────────────
def main():
    args = sys.argv[1:]

    # --version / -v
    if not args or args[0] in ("--version", "-v"):
        return _cmd_version()

    # --help / -h (without subcommand)
    if args[0] in ("--help", "-h"):
        return _cmd_help()

    cmd = args[0]
    rest = args[1:]

    # help <subcommand>
    if cmd in ("help",):
        sub = rest[0] if rest else None
        return _cmd_help(sub)

    # intercept --help / -h for specific commands
    if _help_requested(rest):
        return _cmd_help(cmd)

    # ── Zero-arg commands ──
    if cmd == "init":
        return _cmd_init()
    if cmd in ("install", "setup"):
        return _cmd_install()
    if cmd == "update":
        return _cmd_update()

    # ── Named-repo or path commands (positional) ──
    if cmd in ("scan", "ink", "duster", "run", "health", "report", "ci", "install-hook", "install-cron"):
        if not _requires_name(cmd, rest):
            return 1
        name = rest[0]
        passthrough = rest[1:]
        handlers = {
            "scan": _cmd_scan,
            "ink": _cmd_ink,
            "duster": _cmd_duster,
            "run": _cmd_run,
            "health": _cmd_health,
            "report": _cmd_report,
            "ci": _cmd_ci,
            "install-hook": _cmd_install_hook,
            "install-cron": _cmd_install_cron,
        }
        fn = handlers[cmd]
        if cmd == "duster":
            return fn(name)
        return fn(name, passthrough)

    # ── Commands with optional repo name ──
    if cmd == "status":
        return _cmd_status(rest)
    if cmd == "doctor":
        return _cmd_doctor(rest)

    # ── Named-argument commands (--repo, --mode, etc.) ──
    if cmd == "onboard":
        return _cmd_onboard(rest)
    if cmd == "preflight":
        return _cmd_preflight(rest)
    if cmd == "heal":
        return _cmd_heal(rest)

    # ── Path command ──
    if cmd == "secrets":
        if not rest:
            print("blenny: 'secrets' requires a path", file=sys.stderr)
            print("Usage: blenny secrets <path>", file=sys.stderr)
            return 1
        return _cmd_secrets(rest[0])

    # Unknown command
    print(f"blenny: unknown command '{cmd}'", file=sys.stderr)
    print("Run 'blenny help' for available commands.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
