# Blenny QA — Autonomous repository quality workflow
# Generated by `blenny ci {{ repo_name }}`
name: Blenny QA

on:
  push:
    branches:
      - main
      - master
  pull_request:
    branches:
      - main
      - master
  workflow_dispatch:
    inputs:
      phase:
        description: 'QA cycle phase to run'
        required: true
        default: 'orchestrated'
        type: choice
        options:
          - issue-cycle
          - pr-cycle
          - review-cycle
          - merge-cycle
          - orchestrated

env:
  PYTHON_VERSION: "3.11"
  BLENNY_DIR: ${{ github.workspace }}/.blenny
  REPO_PATH: ${{ github.workspace }}

jobs:
  qa-scan:
    name: Blenny QA Scan
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      issues: write
      pull-requests: write
      checks: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Install Blenny QA Agent
        run: |
          pip install --upgrade pip
          pip install -e __BLENNY_INSTALL_PATH__

      - name: Install system dependencies
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq shellcheck 2>/dev/null || true
          if command -v node &>/dev/null; then
            npm install -g markdownlint-cli actionlint 2>/dev/null || true
          fi

      - name: Run Blenny Scan
        id: blenny-scan
        continue-on-error: true
        run: |
          blenny scan . \
            --phase ${{ github.event.inputs.phase || 'issue-cycle' }} \
            --format json 2>&1 | tee blenny-output.json

      - name: Upload Findings Artifact
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: blenny-findings
          path: |
            blenny-output.json
            .blenny/state/*.json
            .blenny/logs/*.log
          retention-days: 14
          if-no-files-found: warn

      - name: Post findings summary
        if: steps.blenny-scan.outcome == 'success' || steps.blenny-scan.outcome == 'failure'
        run: |
          echo "## Blenny QA Results" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          if [ -f blenny-output.json ]; then
            echo '```json' >> $GITHUB_STEP_SUMMARY
            head -c 2000 blenny-output.json >> $GITHUB_STEP_SUMMARY
            echo '' >> $GITHUB_STEP_SUMMARY
            echo '```' >> $GITHUB_STEP_SUMMARY
          else
            echo "No blenny-output.json found — scan may have failed early." >> $GITHUB_STEP_SUMMARY
          fi