# bluei — Autonomous repository quality workflow
# Generated by `bluei ci __REPO_NAME__`
name: bluei

on:
  push:
    branches:
      - main
      - master
  pull_request:
    branches:
      - main
      - master
  workflow_dispatch:
    inputs:
      phase:
        description: 'QA cycle phase to run'
        required: true
        default: 'orchestrated'
        type: choice
        options:
          - issue-cycle
          - pr-cycle
          - review-cycle
          - merge-cycle
          - orchestrated

env:
  PYTHON_VERSION: "3.11"
  BLUEI_DIR: ${{ github.workspace }}/.bluei
  REPO_PATH: ${{ github.workspace }}

jobs:
  qa-scan:
    name: bluei Scan
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      issues: write
      pull-requests: write
      checks: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Install bluei
        run: |
          pip install --upgrade pip
          __BLUEI_INSTALL_CMD__

      - name: Install system dependencies
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq shellcheck 2>/dev/null || true
          if command -v node &>/dev/null; then
            npm install -g markdownlint-cli actionlint 2>/dev/null || true
          fi

      - name: Run bluei Scan
        id: bluei-scan
        continue-on-error: true
        run: |
          bluei scan . \
            --phase ${{ github.event.inputs.phase || 'issue-cycle' }} \
            --format json 2>&1 | tee bluei-output.json

      - name: Upload Findings Artifact
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: bluei-specks
          path: |
            bluei-output.json
            .bluei/state/*.json
            .bluei/logs/*.log
          retention-days: 14
          if-no-files-found: warn

      - name: Post findings summary
        if: steps.bluei-scan.outcome == 'success' || steps.bluei-scan.outcome == 'failure'
        run: |
          echo "## bluei Results" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          if [ -f bluei-output.json ]; then
            echo '```json' >> $GITHUB_STEP_SUMMARY
            head -c 2000 bluei-output.json >> $GITHUB_STEP_SUMMARY
            echo '' >> $GITHUB_STEP_SUMMARY
            echo '```' >> $GITHUB_STEP_SUMMARY
          else
            echo "No bluei-output.json found — scan may have failed early." >> $GITHUB_STEP_SUMMARY
          fi
